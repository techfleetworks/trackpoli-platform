# TrackPoli environment variables. Copy to .env.local (gitignored) and fill in.
# NEXT_PUBLIC_* are exposed to the browser (safe only because RLS is enabled).
# Everything else is server-only and must NEVER be prefixed NEXT_PUBLIC_.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. Used only by the admin data pipeline.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sanity (editorial prose; may be deferred past MVP 1) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only tokens (only if the dataset is private / for editorial writes).
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
