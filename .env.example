# TrackPoli admin — local/example environment. Copy to .env.local and fill in. NEVER commit real values.
# Secrets (service-role key, SMTP password, Turnstile secret, Google client secret) live ONLY in the
# service's own settings (Supabase / Vercel / Edge Function secrets), never here and never in the browser.
# See the Phase 1 plan, section 1 (Environment variables), and docs/setup/tp1-02-credentials.md for the
# step-by-step account setup (which value comes from where and where each one goes).
#
# Google sign-in has NO env var here: the Google client id/secret live in the Supabase Auth dashboard,
# and the app only finishes the handshake at /admin/auth/callback.
# Deploy/CI secrets (VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, SUPABASE access token,
# SENTRY_AUTH_TOKEN) are GitHub Actions secrets, not app env — see the checklist above.

# --- Browser-exposed (NEXT_PUBLIC_*). Only server code reads the anon key; the browser never calls Supabase. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000/admin
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (Vercel server env). Never exposed to the browser. ---
APP_URL=http://localhost:3000/admin
INTERNAL_CALL_SECRET=
# Service-role key for the server-only admin client (src/lib/supabase/admin.ts). Bypasses RLS; set it in
# Vercel server env (NOT a NEXT_PUBLIC_ var) and in the Supabase Edge Function secrets. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Edge Function secrets (set in Supabase, listed here for reference only; do not put real values here) ---
# SUPABASE_URL, SUPABASE_ANON_KEY  (provided by Supabase at runtime)
# SUPABASE_SERVICE_ROLE_KEY        (Edge Functions + CI only)
# ALLOWED_ORIGINS                  (exact origins; normally empty; never *)
# SENTRY_DSN
# TURNSTILE_SECRET_KEY
